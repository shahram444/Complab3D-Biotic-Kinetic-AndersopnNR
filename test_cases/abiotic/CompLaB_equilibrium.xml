<?xml version="1.0" ?>
<!--
================================================================================
CompLaB3D Configuration — Abiotic + Equilibrium Chemistry (PCF + Anderson AA)
================================================================================
PURPOSE:
  Test carbonate equilibrium chemistry in abiotic (no-biofilm) mode.
  Three species are transported and kept in thermodynamic equilibrium at
  every time step via the PCF + Anderson Acceleration solver.
  No kinetic reactions.  No microbes.

CHEMISTRY (3 substrates):
  substrate0: CO2    — governed by equilibrium with HCO3- and H+
  substrate1: HCO3-  — master component #1 (bicarbonate)
  substrate2: H+     — master component #2 (pH proxy)

EQUILIBRIUM (log-K formulation, 2 master components: HCO3-, H+):
  log[CO2]  = +6.35 + log[HCO3-] + log[H+]      (CO2 + H2O ⇌ HCO3- + H+, pKa1=6.35)
  log[HCO3-]=  0.00 + log[HCO3-]                 (component — identity)
  log[H+]   =  0.00               + log[H+]       (component — identity)

INITIAL CONDITIONS:
  CO2   = 1.0e-5 mol/L  (inlet Dirichlet, pure CO2 spike)
  HCO3- = 2.0e-3 mol/L  (background alkalinity, Dirichlet)
  H+    = 1.0e-7 mol/L  (pH 7, Dirichlet at inlet)

WHAT TO LOOK FOR:
  After equilibrium converges:
  - CO2 concentration is consistent with pKa1:
      [CO2] = 10^6.35 × [HCO3-] × [H+]
    At initial conditions (pH 7, HCO3-=2e-3):
      [CO2]_eq = 10^6.35 × 2e-3 × 1e-7 ≈ 4.5e-3 mol/L
  - Solver prints equilibrium convergence messages at each ADE step
  - VTI files show spatially varying CO2 consistent with carbonate speciation

DOMAIN: 50 × 30 × 30 lattice, dx = 1 µm
FLOW: Pe = 1.0, deltaP = 2.0e-3 (advection-diffusion)

RUN:
  cp CompLaB_equilibrium.xml CompLaB.xml
  mkdir -p input && cp ../../input/geometry.dat ./input/
  mpirun -np <N> /path/to/complab 2>&1 | tee run.log

NOTE: Solver always reads "CompLaB.xml" from CWD.
================================================================================
-->
<parameters>

    <path>
        <src_path>src</src_path>
        <input_path>input</input_path>
        <output_path>output_abiotic_equilibrium</output_path>
    </path>

    <simulation_mode>
        <biotic_mode>false</biotic_mode>
        <enable_kinetics>false</enable_kinetics>
        <enable_abiotic_kinetics>false</enable_abiotic_kinetics>
        <enable_validation_diagnostics>true</enable_validation_diagnostics>
    </simulation_mode>

    <LB_numerics>
        <domain>
            <nx>50</nx>
            <ny>30</ny>
            <nz>30</nz>
            <dx>1.0</dx>
            <unit>um</unit>
            <characteristic_length>30</characteristic_length>
            <filename>geometry.dat</filename>
            <material_numbers>
                <pore>2</pore>
                <solid>0</solid>
                <bounce_back>1</bounce_back>
            </material_numbers>
        </domain>
        <delta_P>2.0e-3</delta_P>
        <Peclet>1.0</Peclet>
        <tau>0.8</tau>
        <track_performance>false</track_performance>
        <iteration>
            <ade_max_iT>3000</ade_max_iT>
            <ade_converge_iT>1e-7</ade_converge_iT>
        </iteration>
    </LB_numerics>

    <chemistry>
        <number_of_substrates>3</number_of_substrates>

        <!-- CO2: equilibrium species. Concentration set by mass action from HCO3- and H+ -->
        <substrate0>
            <name_of_substrates>CO2</name_of_substrates>
            <initial_concentration>1.0e-5</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>1.9e-9</in_pore>
                <in_biofilm>2.0e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <right_boundary_type>Neumann</right_boundary_type>
            <left_boundary_condition>1.0e-5</left_boundary_condition>
            <right_boundary_condition>0.0</right_boundary_condition>
        </substrate0>

        <!-- HCO3-: master component #1 — alkalinity carried by advection-diffusion -->
        <substrate1>
            <name_of_substrates>HCO3</name_of_substrates>
            <initial_concentration>2.0e-3</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>1.2e-9</in_pore>
                <in_biofilm>2.0e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <right_boundary_type>Neumann</right_boundary_type>
            <left_boundary_condition>2.0e-3</left_boundary_condition>
            <right_boundary_condition>0.0</right_boundary_condition>
        </substrate1>

        <!-- H+: master component #2 — pH carried by advection-diffusion -->
        <substrate2>
            <name_of_substrates>Hplus</name_of_substrates>
            <initial_concentration>1.0e-7</initial_concentration>
            <substrate_diffusion_coefficients>
                <in_pore>9.3e-9</in_pore>
                <in_biofilm>2.0e-10</in_biofilm>
            </substrate_diffusion_coefficients>
            <left_boundary_type>Dirichlet</left_boundary_type>
            <right_boundary_type>Neumann</right_boundary_type>
            <left_boundary_condition>1.0e-7</left_boundary_condition>
            <right_boundary_condition>0.0</right_boundary_condition>
        </substrate2>
    </chemistry>

    <microbiology>
        <number_of_microbes>0</number_of_microbes>
    </microbiology>

    <!--
    ============================================================================
    EQUILIBRIUM — Carbonate system (PCF + Anderson Acceleration)
    ============================================================================
    Components: HCO3- (index 0), H+ (index 1)

    Stoichiometry and logK indexed to match substrate order above:
      species0 = CO2    : log[CO2]   = +6.35 + log[HCO3-] + log[H+]
      species1 = HCO3-  : log[HCO3-] =  0    + log[HCO3-]             (component)
      species2 = H+     : log[H+]    =  0                 + log[H+]    (component)
    ============================================================================
    -->
    <equilibrium>
        <enabled>true</enabled>
        <components>HCO3- H+</components>
        <stoichiometry>
            <species0>1.0  1.0</species0>
            <species1>1.0  0.0</species1>
            <species2>0.0  1.0</species2>
        </stoichiometry>
        <logK>
            <species0>6.35</species0>
            <species1>0.0</species1>
            <species2>0.0</species2>
        </logK>
    </equilibrium>

    <IO>
        <read_NS_file>false</read_NS_file>
        <read_ADE_file>false</read_ADE_file>
        <save_VTK_interval>1000</save_VTK_interval>
        <save_CHK_interval>3000</save_CHK_interval>
    </IO>

</parameters>
